@model FinanceTracker.Presentation.ViewModels.CreateBudgetViewModel
@{
    ViewData["Title"] = "Edit Budget";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Edit Budget</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select a category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Limit" class="form-label">Monthly Limit</label>
                                <input asp-for="Limit" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="Limit" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Period" class="form-label">Period</label>
                                <select asp-for="Period" class="form-select">
                                    @foreach (var period in Model.Periods)
                                    {
                                        <option value="@period">@period</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="AlertEnabled" type="checkbox" class="form-check-input" />
                                <label asp-for="AlertEnabled" class="form-check-label">Enable Alerts</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AlertThreshold" class="form-label">Alert at % of Limit</label>
                            <input asp-for="AlertThreshold" class="form-control" type="number" step="1" min="0" max="100" />
                            <small class="form-text text-muted">You'll be notified when spending reaches this percentage of your limit</small>
                            <span asp-validation-for="AlertThreshold" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Update Budget</button>
                            <a asp-action="Index" asp-controller="Budget" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}